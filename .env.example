# ---------------------------------------------------------------------------
# Tourniquet - variables de entorno (EJEMPLO. copiar a .env y completar)
#
# Este archivo es el CATALOGO. Lo valida backend/src/config/env.schema.ts
# (esquema Joi): si una variable esta mal, la app no arranca y dice cual.
# La lista de abajo tiene que coincidir con ese esquema; si agregas una aca,
# agregala tambien alla, o el ejemplo va a mentir.
#
# Como probarlo:  npm run verificar:clave
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Puerto HTTP del backend. Numerico (Joi lo convierte desde el texto del .env).
PORT=3001

# Origen(es) que pueden llamar al backend, separados por coma.
# Vacio = CORS deshabilitado, que es lo correcto mientras no haya portal.
# Nunca `*`: cada app declara su origen exacto en cat_aplicacion.origenes.
# OJO desde la Fase 04: el PORTAL es un consumidor mas. En desarrollo, el portal
# corre en 3002 y sin esta variable la cookie de sesion no viaja: el login
# "funciona" y al refrescar da 401 (trampa 2 de la fase 04).
#CORS_ORIGIN=https://portal.tourniquet.ar
CORS_ORIGIN=http://localhost:3002

# --- Base de control --------------------------------------------------------

# La lee Prisma. Engine UNICO: SQL Server (specs/02).
# OJO: el usuario tiene que tener `dbo` como esquema por defecto
# (SELECT SCHEMA_NAME() tiene que devolver 'dbo').
DATABASE_URL=sqlserver://USUARIO_SIN_CLAVE@149.50.137.54:1433;database=tourniquet;user=USUARIO;password=CAMBIAR;encrypt=true;trustServerCertificate=true;connectionTimeout=15

# --- Tokens OIDC ------------------------------------------------------------

# Issuer que va en el claim `iss`. Debe ser la URL PUBLICA del IdP, tal como la
# ven las apps: no un localhost si las apps van a estar en otro servidor.
# En produccion tiene que ser https: el arranque se corta si no lo es.
TQ_ISSUER=http://localhost:3001

# URL base del PORTAL (Next). La usa /oidc/authorize para mandar al login cuando
# el usuario todavia no tiene sesion central.
# 3002 y no 3000 porque en la semilla de desarrollo el 3000 lo tiene la app
# `rhpro` (ver deploy/sql/90-semilla-catalogo.sql); el portal y la app no pueden
# escuchar el mismo puerto.
# Vacio = el authorize responde `portal_no_configurado` en vez de redirigir a un
# destino inventado.
TQ_PORTAL_URL=http://localhost:3002

# Vida del access token en minutos (specs/01 §3).
ACCESS_TTL_MIN=15

# Requests por minuto por IP y por usuario en /auth/login y /oidc/token
# (specs/01 §4). El peor de los dos manda.
# OJO: subirlo es para pruebas de flujo completo por curl (el criterio de
# aceptacion de la Fase 03 hace mas de 10 llamadas a /oidc/token en un minuto).
# Bajarlo del default es cambiar el spec, no el .env.
RATE_LIMIT_POR_MINUTO=10

# --- Seguridad: OBLIGATORIA -------------------------------------------------

# 32 bytes en base64 = 44 caracteres.
#
# Generar:  npm run generar:clave
#
# NO es recuperable. Si se pierde, hay que regenerar las claves de firma de
# tok_clave_firma y volver a cifrar TODAS las credenciales de cat_base_datos.
# En produccion va al gestor de secretos del cliente, no a este archivo.
#
# El placeholder de abajo es invalido a proposito: si se pega tal cual, el
# arranque se corta y lo dice.
TQ_MASTER_KEY=PEGAR_AQUI_LO_QUE_IMPRIME_NPM_RUN_GENERAR_CLAVE

# Solo para correr `npm run bootstrap:admin` sin prompt (pipelines).
# OJO: una variable de entorno queda en el historial del shell y es visible
# para otros procesos del usuario. El prompt con eco oculto es lo preferible.
#TQ_BOOTSTRAP_CLAVE=
