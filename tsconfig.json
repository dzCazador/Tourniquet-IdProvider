{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true,
    "emitDecoratorMetadata": true
  },
  "include": ["backend", "frontend", "scripts", "specs", "deploy"],
  "exclude": ["node_modules"]
}